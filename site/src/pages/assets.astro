---
// Astro page to display all assets and PDF from the main assets folder
const assets = [
  '1.png',
  '2.png',
  '3.png',
  '4.png',
  '5.png',
  '6.png',
  'Frame 1.png',
  'poster1.png',
];
const pdfFile = 'MaxxVim.pdf';
---

<html>
  <head>
    <title>MaxxVim Assets</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      
      body {
        background: #fafafa;
        color: #1a1a1a;
        font-family: 'Inter', sans-serif;
        font-weight: 300;
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
      }
      
      .container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 60px 40px 120px;
      }
      
      .header {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        margin-bottom: 120px;
        border-bottom: 1px solid #e5e5e5;
        padding-bottom: 40px;
      }
      
      .title {
        font-size: 32px;
        font-weight: 300;
        letter-spacing: -0.02em;
        color: #1a1a1a;
      }
      
      .pdf-link {
        color: #666;
        text-decoration: none;
        font-size: 14px;
        font-weight: 400;
        letter-spacing: 0.02em;
        text-transform: uppercase;
        position: relative;
        transition: color 0.3s ease;
      }
      
      .pdf-link::after {
        content: '';
        position: absolute;
        bottom: -4px;
        left: 0;
        width: 0;
        height: 1px;
        background: #1a1a1a;
        transition: width 0.3s ease;
      }
      
      .pdf-link:hover {
        color: #1a1a1a;
      }
      
      .pdf-link:hover::after {
        width: 100%;
      }
      
      .gallery {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 80px 60px;
      }
      
      .gallery-item {
        opacity: 0;
        transform: translateY(60px);
        transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.6s ease;
      }
      
      .gallery-item.visible {
        opacity: 1;
        transform: translateY(0);
      }
      
      .image-wrapper {
        position: relative;
        overflow: hidden;
        margin-bottom: 20px;
        cursor: pointer;
      }
      
      .gallery-item img {
        width: 100%;
        height: 400px;
        object-fit: cover;
        transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        filter: grayscale(1) contrast(1.1);
      }
      
      .gallery-item:hover img {
        transform: scale(1.05);
        filter: grayscale(0) contrast(1);
      }
      
      .caption {
        font-size: 13px;
        color: #999;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        font-weight: 400;
      }
      
      @media (max-width: 768px) {
        .container {
          padding: 40px 20px 80px;
        }
        
        .header {
          flex-direction: column;
          align-items: flex-start;
          gap: 20px;
          margin-bottom: 80px;
        }
        
        .title {
          font-size: 24px;
        }
        
        .gallery {
          grid-template-columns: 1fr;
          gap: 60px;
        }
        
        .gallery-item img {
          height: 300px;
        }
      }
      
      @media (max-width: 480px) {
        .container {
          padding: 30px 16px 60px;
        }
        
        .gallery {
          gap: 40px;
        }
        
        .gallery-item img {
          height: 250px;
        }
      }
    </style>
  </head>
  <body>
    <div class="container">
      <header class="header">
        <h1 class="title">MaxxVim Assets</h1>
        <a class="pdf-link" href={`/assets/${pdfFile}`} target="_blank">View PPT File</a>
      </header>
      
      <div class="gallery">
        {assets.map((asset, index) => (
          <article class="gallery-item" style={`transition-delay: ${index * 0.1}s`}>
            <div class="image-wrapper">
              <img src={`/assets/${asset}`} alt={asset} loading="lazy" />
            </div>
            <div class="caption">{asset.replace('.png', '').replace(/^\d+$/, `Image ${asset.charAt(0)}`)}</div>
          </article>
        ))}
      </div>
    </div>
    
    <script>
      const observerOptions = {
        threshold: 0.1,
        rootMargin: '0px 0px -50px 0px'
      };
      
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
          }
        });
      }, observerOptions);
      
      document.addEventListener('DOMContentLoaded', () => {
        const galleryItems = document.querySelectorAll('.gallery-item');
        galleryItems.forEach(item => observer.observe(item));
      });
    </script>
  </body>
</html>
